# Server
NODE_ENV=development
PORT=3000

# Development flag: allow server to start even if DB is unavailable/misconfigured.
# Useful for smoke-testing `/health` without provisioning Postgres.
ALLOW_START_WITHOUT_DB=false

# Database (PostgreSQL via Neon/Supabase/Railway)
DATABASE_URL=postgresql://user:password@host:5432/nexusai?sslmode=require

# Redis (Upstash/Railway — BullMQ requires standard redis:// or rediss://, NOT the Upstash REST URL)
REDIS_URL=rediss://default:password@host:6379

# Authentication
JWT_SECRET=your-32-character-random-secret-here
JWT_REFRESH_SECRET=your-32-character-refresh-secret

# Firebase Auth
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_BASE64=base64-encoded-service-account-json

# AI Provider: "nvidia" | "openai" | "anthropic"
AI_PROVIDER=nvidia
AI_MODEL=meta/llama-3.3-70b-instruct

# NVIDIA NIM API (OpenAI-compatible)
NVIDIA_API_KEY=nvapi-your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# OpenAI (alternative to NVIDIA)
OPENAI_API_KEY=sk-your-openai-key

# Anthropic (alternative)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# AWS S3 / Cloudflare R2 (optional — for media uploads)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=nexusai-media-dev
AWS_REGION=us-east-1
CDN_BASE_URL=http://localhost:3000/media

# RevenueCat (optional — for subscriptions)
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret
